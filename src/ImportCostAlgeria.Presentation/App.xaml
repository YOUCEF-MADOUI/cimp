<Application x:Class="ImportCostAlgeria.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ImportCostAlgeria.Presentation.Converters"
             xmlns:vm="clr-namespace:ImportCostAlgeria.Presentation.ViewModels"
             xmlns:views="clr-namespace:ImportCostAlgeria.Presentation.Views">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Revue du 2026-10-02 (REFONTE INTERFACE, Section 2) : associations ViewModel -> Vue -->
            <!-- déclarées GLOBALEMENT (déplacées depuis MainWindow.xaml) afin de s'appliquer aussi bien à -->
            <!-- la fenêtre principale qu'aux nouvelles fenêtres "Paramètres" (ChildScreenWindow). -->
            <DataTemplate DataType="{x:Type vm:DashboardScreenViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EntreprisesViewModel}">
                <views:EntreprisesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImportationsViewModel}">
                <views:ImportationsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImportDetailViewModel}">
                <views:ImportDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReglementationViewModel}">
                <views:ReglementationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TauxDeChangeViewModel}">
                <views:TauxDeChangeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
                <views:AuditLogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ParametresViewModel}">
                <views:ParametresView />
            </DataTemplate>

            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <conv:DateOnlyConverter x:Key="DateOnlyConverter" />
            <conv:FlexibleDecimalConverter x:Key="FlexibleDecimalConverter" />
            <!-- Revue du 2026-10-02 (REFONTE INTERFACE — Section 6/7/13) : affichage monétaire avec -->
            <!-- symbole après le montant (DA/€/$), jamais une colonne de devise séparée. -->
            <conv:MoneyWithFixedCurrencyConverter x:Key="MoneyDaConverter" />
            <conv:MoneyWithDynamicCurrencyConverter x:Key="MoneyDynamicConverter" />
            <conv:CurrencyCodeToSymbolConverter x:Key="CurrencyCodeToSymbolConverter" />

            <Style TargetType="Button">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="MinWidth" Value="90" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="Margin" Value="4" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="Margin" Value="4,4,4,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="AlternatingRowBackground" Value="#F5F7FA" />
                <Setter Property="RowHeaderWidth" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
