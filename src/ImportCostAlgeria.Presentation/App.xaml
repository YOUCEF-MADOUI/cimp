<Application x:Class="ImportCostAlgeria.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ImportCostAlgeria.Presentation.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <conv:DateOnlyConverter x:Key="DateOnlyConverter" />

            <Style TargetType="Button">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="MinWidth" Value="90" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="Margin" Value="4" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="Margin" Value="4,4,4,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="AlternatingRowBackground" Value="#F5F7FA" />
                <Setter Property="RowHeaderWidth" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
