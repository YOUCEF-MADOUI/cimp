<UserControl x:Class="ImportCostAlgeria.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Tableau de bord" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <UniformGrid Columns="4" Rows="1">
            <Border Background="#E8F0FE" Margin="4" Padding="16" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Importations calculées" FontSize="11" Foreground="Gray" />
                    <TextBlock Text="{Binding NombreImportations}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#E6F4EA" Margin="4" Padding="16" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Produits au catalogue" FontSize="11" Foreground="Gray" />
                    <TextBlock Text="{Binding NombreDeProduits}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#FEF7E0" Margin="4" Padding="16" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Total droits de douane (DA)" FontSize="11" Foreground="Gray" />
                    <TextBlock Text="{Binding TotalDroitsDeDouaneDzd, StringFormat=N2}" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#FCE8E6" Margin="4" Padding="16" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Importations bloquées" FontSize="11" Foreground="Gray" />
                    <TextBlock Text="{Binding NombreDAnomaliesBloquantes}" FontSize="26" FontWeight="Bold" Foreground="DarkRed" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Background="#F1F3F4" Margin="4,16,4,4" Padding="16" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Coût total de revient (toutes importations calculées)" FontSize="11" Foreground="Gray" />
                <TextBlock Text="{Binding CoutTotalDzd, StringFormat={}{0:N2} DZD}" FontSize="30" FontWeight="Bold" />
            </StackPanel>
        </Border>

        <TextBlock Text="Dernières importations calculées" FontSize="14" FontWeight="Bold" Margin="4,20,4,8" />
        <ListBox ItemsSource="{Binding DernieresImportations}" MaxHeight="220" />
    </StackPanel>
</UserControl>
