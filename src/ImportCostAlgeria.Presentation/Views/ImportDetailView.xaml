<UserControl x:Class="ImportCostAlgeria.Presentation.Views.ImportDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:ImportCostAlgeria.Core.Services;assembly=ImportCostAlgeria.Core"
             x:Name="Root">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="&#8592; Retour à la liste" Command="{Binding BackCommand}" />
            <TextBlock Text="{Binding HeaderLabel}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Visibility="{Binding HasBlockingAnomalies, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#FCE8E6" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="🚫 Cette importation comporte des anomalies BLOQUANTES : le coût de revient ne peut pas être considéré comme définitif."
                       Foreground="DarkRed" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>

        <!-- Revue du 2026-10-02 (correction urgente, Section 15) : bandeau ORANGE distinct du bandeau -->
        <!-- rouge ci-dessus — le calcul s'est exécuté avec succès mais reste PROVISOIRE (taux par défaut -->
        <!-- de l'importation utilisés en l'absence de règle réglementaire officielle). -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding IsProvisionalCalculation, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#FFF4CE" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding ProvisionalMessageFr}"
                       Foreground="#7A5B00" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>

        <!-- Section 14 : chaque taxe affichée SÉPARÉMENT (plus un seul total "Autres taxes" agrégé) — -->
        <!-- tous les totaux affichent explicitement leur unité (DZD), jamais un nombre nu. -->
        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,0,8">
            <TextBlock><Run Text="Valeur en douane (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalValeurDouaneDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="Droits de douane (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalDroitsDouaneDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="CS (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalCsDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="PRCT (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalPrctDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="TCS (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalTcsDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="DAPS (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalDapsDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="TVA import (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalTvaDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="RPS (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalRpsDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="Frais alloués (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalFraisDzd, Mode=OneWay, StringFormat=N2}"/></TextBlock>
            <TextBlock><Run Text="Coût de revient total (DZD) : " FontWeight="Bold"/><Run Text="{Binding TotalCoutRevientDzd, Mode=OneWay, StringFormat=N2}" FontWeight="Bold"/></TextBlock>
        </UniformGrid>

        <TabControl>
            <TabItem Header="Articles">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                        <Button Content="Ajouter un article manuellement" Command="{Binding AddLineCommand}" />
                        <Button Content="Importer depuis Excel / CSV..." Command="{Binding ImportExcelCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Référence" Binding="{Binding ProductReference}" Width="90" />
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="160" />
                            <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="55" />
                            <DataGridTextColumn Header="Prix unit." Binding="{Binding UnitPurchasePrice}" Width="75" />
                            <DataGridTextColumn Header="Dev." Binding="{Binding CurrencyCode}" Width="50" />
                            <DataGridTextColumn Header="Origine" Binding="{Binding OriginCountryIso2}" Width="55" />
                            <DataGridTextColumn Header="Code SH confirmé" Binding="{Binding HsCodeConfirmed10}" Width="110" />
                            <DataGridTextColumn Header="Statut IA" Binding="{Binding AiHsSummary}" Width="140" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="SH (IA)" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Proposer" Command="{Binding DataContext.ConfirmHsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Droit Excel %" Binding="{Binding ExcelDutyRatePercent, Converter={StaticResource FlexibleDecimalConverter}}" Width="85" />
                            <!-- Section 35 : recherche/allocation par Poids et Volume abandonnée pour V1 -->
                            <!-- (champs conservés dans le modèle pour une évolution future, mais non proposés ici). -->
                            <!-- Section 12 : la TVA ne doit jamais rester silencieusement à 0 % en l'absence de règle -->
                            <!-- officielle — saisie/confirmation manuelle possible, avec motif d'exonération si 0 %. -->
                            <DataGridTextColumn Header="TVA manuelle %" Binding="{Binding ManualVatRatePercent, Converter={StaticResource FlexibleDecimalConverter}}" Width="95" />
                            <DataGridCheckBoxColumn Header="TVA manuelle confirmée" Binding="{Binding UserConfirmedManualVatRate}" Width="90" />
                            <DataGridTextColumn Header="Motif exonération TVA" Binding="{Binding VatExemptionReasonFr}" Width="140" />
                            <DataGridTextColumn Header="Valeur douane" Binding="{Binding ValeurDouaniereDzd, StringFormat=N2}" Width="95" IsReadOnly="True" />
                            <DataGridTextColumn Header="Droit douane" Binding="{Binding DroitDouaneDzd, StringFormat=N2}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="TVA" Binding="{Binding TvaDzd, StringFormat=N2}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Coût de revient" Binding="{Binding CoutRevientDzd, StringFormat=N2}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Coût unitaire" Binding="{Binding CoutUnitaireDzd, StringFormat=N2}" Width="90" IsReadOnly="True" />
                            <!-- Section 12 du plan multi-devises : colonnes de conversion COMMERCIALE (ex: EUR -> USD), vides quand non applicable -->
                            <DataGridTextColumn Header="PU Autorisation" Binding="{Binding AuthorizationUnitPrice, StringFormat=N2}" Width="95" IsReadOnly="True" />
                            <DataGridTextColumn Header="Total Autorisation" Binding="{Binding AuthorizationTotalAmount, StringFormat=N2}" Width="105" IsReadOnly="True" />
                            <DataGridTextColumn Header="Dev. Autorisation" Binding="{Binding AuthorizationCurrencyLabel}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="État" Binding="{Binding EtatLabel}" Width="100" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Détail" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Voir" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="✕" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Frais (19 catégories)">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                        <ComboBox ItemsSource="{Binding FeeTemplates}" SelectedItem="{Binding SelectedFeeTemplate}"
                                  DisplayMemberPath="DefaultLabelFr" Width="260" />
                        <Button Content="Ajouter ce frais" Command="{Binding AddFeeCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Fees}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding FeeCategoryCode}" Width="140" />
                            <DataGridTextColumn Header="Libellé" Binding="{Binding FeeName}" Width="160" />
                            <DataGridTextColumn Header="Montant" Binding="{Binding Amount}" Width="90" />
                            <DataGridTextColumn Header="Devise" Binding="{Binding CurrencyCode}" Width="60" />
                            <DataGridComboBoxColumn Header="Méthode de répartition" SelectedItemBinding="{Binding AllocationMethod}" Width="150"
                                                     ItemsSource="{x:Static core:ImportFeeCatalog.AllocationMethodsForV1}" />
                            <DataGridCheckBoxColumn Header="Inclus valeur en douane" Binding="{Binding IncludeInCustomsValue}" Width="130" />
                            <DataGridCheckBoxColumn Header="Inclus coût de revient" Binding="{Binding IncludeInCostOfGoods}" Width="130" />
                            <DataGridTemplateColumn Header="Supprimer" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding DataContext.RemoveFeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Taux de change &amp; Incoterm">
                <StackPanel Margin="8">
                    <TextBlock Text="Taux de change applicable" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ExchangeRateInfo}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <CheckBox Content="Utiliser un taux de change manuel (⚠️ déclenchera une alerte si différent du taux officiel)"
                              IsChecked="{Binding IsManualRateMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16" Visibility="{Binding IsManualRateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Content="Taux manuel (1 devise = X DZD) :" />
                        <TextBox Text="{Binding ManualRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" Width="120" />
                    </StackPanel>

                    <Separator Margin="0,4,0,12" />

                    <TextBlock Text="Autorisation d'importation (conversion commerciale, distincte du calcul douanier)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Label Content="Devise de l'autorisation d'importation :" />
                        <TextBox Text="{Binding AuthorizationCurrencyCode, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </StackPanel>
                    <TextBlock Text="{Binding AuthorizationExchangeRateInfo}" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <CheckBox Content="Utiliser un taux commercial manuel (⚠️ distinct du taux réglementaire ci-dessus)"
                              IsChecked="{Binding IsManualAuthorizationRateMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8" Visibility="{Binding IsManualAuthorizationRateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Content="Taux manuel (1 devise facture = X devise autorisation) :" />
                        <TextBox Text="{Binding ManualAuthorizationRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" Width="120" />
                    </StackPanel>

                    <TextBlock Text="{Binding AuthorizationConversionSummary}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBlock Text="Recommandations liées à l'Incoterm" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding IncotermGuidance}" TextWrapping="Wrap" />

                    <Separator Margin="0,12,0,12" />

                    <TextBlock Text="PRCT / TCS : confirmation manuelle (une seule fois pour tout l'import)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Si aucune règle réglementaire officielle PRCT/TCS n'est publiée pour un code SH de cette importation, confirmez ici un taux valable pour TOUTE l'importation (jamais par article) — une règle officielle reste toujours prioritaire si elle existe." />
                    <CheckBox Content="Confirmer un taux PRCT manuel pour cette importation" IsChecked="{Binding IsManualPrctMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12" Visibility="{Binding IsManualPrctMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Content="Taux PRCT manuel (%) :" />
                        <TextBox Text="{Binding ManualPrctRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" Width="80" />
                    </StackPanel>
                    <CheckBox Content="Confirmer un taux TCS manuel pour cette importation" IsChecked="{Binding IsManualTcsMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsManualTcsMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Content="Taux TCS manuel (%) :" />
                        <TextBox Text="{Binding ManualTcsRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" Width="80" />
                    </StackPanel>

                    <Separator Margin="0,12,0,12" />

                    <!-- Revue du 2026-10-02 (correction urgente, Section 20) : taux de taxes PAR DÉFAUT -->
                    <!-- de l'importation, utilisés automatiquement pour TOUS les articles lorsqu'aucune -->
                    <!-- RegulatoryRule officielle n'est trouvée — jamais pour écraser une règle officielle. -->
                    <TextBlock Text="Taux de taxes par défaut (utilisés si la règle réglementaire est introuvable)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Appliqués AUTOMATIQUEMENT à TOUS les articles de cette importation dès qu'aucune règle réglementaire officielle n'a été trouvée pour un code SH — une règle officielle reste toujours prioritaire. Le Droit de Douane (DD) reste résolu article par article : seule la valeur de repli ci-dessous est commune." />
                    <CheckBox Content="☑ Utiliser les taux par défaut lorsque la règle réglementaire est introuvable"
                              IsChecked="{Binding UseDefaultRatesWhenRuleMissing}" Margin="0,0,0,8" FontWeight="Bold" />
                    <Grid Visibility="{Binding UseDefaultRatesWhenRuleMissing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="DD par défaut (%) :" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DefaultDdRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="0" Grid.Column="3" Content="CS (%) :" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding DefaultCsRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="1" Grid.Column="0" Content="PRCT (%) :" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefaultPrctRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="1" Grid.Column="3" Content="TCS (%) :" />
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding DefaultTcsRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="2" Grid.Column="0" Content="TVA (%) :" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DefaultTvaRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="2" Grid.Column="3" Content="RPS suggéré (DZD) :" />
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding DefaultRpsAmountValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Calcul &amp; Contrôles">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
                        <Button Content="▶ Exécuter le calcul complet" Command="{Binding CalculateCommand}" FontWeight="Bold" />
                        <Button Content="Exporter Excel" Command="{Binding ExportExcelCommand}" />
                        <Button Content="Exporter PDF" Command="{Binding ExportPdfCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Anomalies}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Width="110" />
                            <DataGridTextColumn Header="Code" Binding="{Binding AnomalyCode}" Width="160" />
                            <DataGridTextColumn Header="Article n°" Binding="{Binding LineNumber}" Width="70" />
                            <DataGridTextColumn Header="Message" Binding="{Binding MessageFr}" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
