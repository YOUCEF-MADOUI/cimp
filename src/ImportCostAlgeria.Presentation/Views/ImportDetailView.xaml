<UserControl x:Class="ImportCostAlgeria.Presentation.Views.ImportDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:ImportCostAlgeria.Core.Services;assembly=ImportCostAlgeria.Core"
             xmlns:infra="clr-namespace:ImportCostAlgeria.Presentation.Infrastructure"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Revue du 2026-10-02 (REFONTE INTERFACE, Section 10/11) : DataGridColumn n'étant pas dans -->
        <!-- l'arbre visuel, ce proxy permet aux colonnes (en-tête ET visibilité) de se lier au DataContext -->
        <!-- réel de la vue (voir ImportCostAlgeria.Presentation.Infrastructure.BindingProxy). -->
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <DockPanel Margin="16">
        <!-- Section 4/5 de la refonte : barre d'action FIXE en haut (jamais affectée par le scroll du -->
        <!-- contenu ci-dessous) — "Retour à la liste" et "Exécuter le calcul complet" sur la même ligne, -->
        <!-- ce dernier toujours en haut à droite. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="▶ Exécuter le calcul complet" Command="{Binding CalculateCommand}"
                    FontWeight="Bold" Background="#1A237E" Foreground="White" Padding="14,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="&#8592; Retour à la liste" Command="{Binding BackCommand}" />
                <TextBlock Text="{Binding HeaderLabel}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Tâche #20, point 2 (2026-10-05) : SCROLLBAR VERTICALE DE PAGE. Avant cette correction, tout le
             contenu ci-dessous (bandeaux d'anomalies, cartes Valeur en douane/Coût de revient/Total
             dédouanement, détails DD/CS/TVA/PRCT/RPS/DAPS/Frais, onglets Articles/Frais/Taux de
             change & Incoterm/Notifications) était empilé en DockPanel.Dock="Top"/rempli sans AUCUN moyen de
             défiler la PAGE entière : avec beaucoup de notifications, une fenêtre réduite, ou les détails
             dépliés ("Voir les détails"), le bas de la page devenait inaccessible (rien ne permettait de
             faire défiler la page pour l'atteindre). Seule la barre d'action tout en haut (DockPanel
             ci-dessus) reste FIXE, hors défilement, comme annoncé par son commentaire d'origine. Tout le
             reste est désormais placé dans ce ScrollViewer PAGE (vertical uniquement : HorizontalScrollBarVisibility
             ="Disabled" pour ne jamais faire concurrence au défilement horizontal propre du DataGrid
             Articles, qui reste géré par le DataGrid lui-même). -->
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" CanContentScroll="False">
        <StackPanel>

        <Border
                Visibility="{Binding HasBlockingAnomalies, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#FCE8E6" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="🚫 Cette importation comporte des anomalies BLOQUANTES : le coût de revient ne peut pas être considéré comme définitif."
                       Foreground="DarkRed" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>

        <!-- Revue du 2026-10-02 (correction urgente, Section 15) : bandeau ORANGE distinct du bandeau -->
        <!-- rouge ci-dessus — le calcul s'est exécuté avec succès mais reste PROVISOIRE (taux par défaut -->
        <!-- de l'importation utilisés en l'absence de règle réglementaire officielle). -->
        <Border
                Visibility="{Binding IsProvisionalCalculation, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#FFF4CE" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding ProvisionalMessageFr}"
                       Foreground="#7A5B00" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>

        <!-- Correction 2026-10-02 (Étape 2 — "Persistance des calculs après fermeture de CIMP") : bandeau
             BLEU distinct des deux précédents — les totaux affichés ci-dessous restent ceux du dernier
             calcul sauvegardé (jamais remis à zéro), mais les données saisies ont changé depuis : un
             nouveau calcul est nécessaire avant de considérer ces chiffres comme à jour. -->
        <Border
                Visibility="{Binding IsCalculationOutdated, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#E3F2FD" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="ℹ Les données ont été modifiées depuis le dernier calcul : cliquez sur « Exécuter le calcul complet » pour mettre à jour les résultats affichés ci-dessous."
                       Foreground="#0D47A1" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>

        <!-- Correction 2026-10-02 (PRIORITÉ 2 — "Nouvelle présentation des résultats") : les 3 indicateurs
             RÉGLEMENTAIRES principaux (Valeur en douane / Coût de revient / Total dédouanement) côte à
             côte, suivis des 3 indicateurs COMMERCIAUX (Total prix de vente / Total bénéfice / % bénéfice).
             Les résultats secondaires (DD, CS, TVA, PRCT, RPS, DAPS, Frais alloués) restent entièrement
             calculés/disponibles dans le modèle mais sont masqués par défaut, repliés derrière le bouton
             "Voir les détails" — aucune donnée supprimée, uniquement une amélioration de présentation. -->
        <Border Background="#F5F7FA" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <UniformGrid Columns="3">
                    <Border Margin="4" Background="#1A237E" Padding="8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="VALEUR EN DOUANE" FontWeight="Bold" Foreground="White" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CustomsValueDisplayAmount, StringFormat=N2, TargetNullValue='—'}" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CustomsValueDisplayCurrency}" FontSize="11" Margin="3,0,8,0" VerticalAlignment="Bottom" Foreground="White" />
                                <ComboBox ItemsSource="{Binding CustomsValueDisplayCurrencies}" SelectedItem="{Binding CustomsValueDisplayCurrency}" Width="60" />
                            </StackPanel>
                            <!-- Section 7 (correction 2026-10-02) : message explicite si la conversion d'affichage
                                 est indisponible — jamais un simple "—" sans explication. La valeur réglementaire
                                 en DZD ci-dessus reste, elle, toujours exacte et inchangée. -->
                            <TextBlock Text="{Binding CustomsValueDisplayErrorFr}"
                                       Visibility="{Binding CustomsValueDisplayErrorFr, Converter={StaticResource StringToVisibilityConverter}}"
                                       FontSize="10" Foreground="#FFCDD2" TextWrapping="Wrap" MaxWidth="220" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4" Background="#1A237E" Padding="8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="COÛT DE REVIENT" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding TotalCoutRevientDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="17" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <!-- Tâche #21, point 2 (audit RPS) : infobulle explicite sur la composition exacte de ce
                         total (DD + CS + TVA + PRCT + TCS + RPS) — le RPS y figure À PART ENTIÈRE comme
                         composante propre du dédouanement, distincte de son apparition séparée dans "Frais
                         alloués" ci-dessous (deux indicateurs DISTINCTS, jamais sommés l'un avec l'autre :
                         voir COÛT DE REVIENT, qui seul agrège réellement tous les montants, chacun une seule
                         fois). -->
                    <Border Margin="4" Background="#1A237E" Padding="8" CornerRadius="4"
                            ToolTip="TOTAL DÉDOUANEMENT = Droits de douane (DD) + CS + TVA + PRCT + TCS + RPS. Le RPS apparaît ici ET dans « Frais alloués » ci-dessous (deux totaux distincts) ; il n'est compté qu'UNE SEULE fois dans le COÛT DE REVIENT.">
                        <StackPanel>
                            <TextBlock Text="TOTAL DÉDOUANEMENT" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding TotalDedouanementDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="17" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Section "Calcul du prix de vente / bénéfice" : indicateurs COMMERCIAUX, calculés
                     exclusivement à partir des prix de vente réellement saisis (jamais le coût de revient
                     utilisé comme prix de vente) — voir ImportDetailViewModel.RecomputeCommercialTotals. -->
                <UniformGrid Columns="3" Margin="0,8,0,0">
                    <Border Margin="4" Background="White" BorderBrush="#C5CAE9" BorderThickness="1" Padding="8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="TOTAL PRIX DE VENTE" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalPrixVenteDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4" Background="White" BorderBrush="#C5CAE9" BorderThickness="1" Padding="8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="TOTAL BÉNÉFICE" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalBeneficeDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4" Background="White" BorderBrush="#C5CAE9" BorderThickness="1" Padding="8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="MARGE / % BÉNÉFICE" FontWeight="Bold" />
                            <TextBlock Text="{Binding PourcentageBeneficeDisplayFr}" FontSize="15" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Bouton "Voir les détails" (même motif que ToggleAnomalyDetailsCommand ci-dessous, Section
                     "Notifications") : masque/affiche DD, CS, TVA, PRCT, RPS, DAPS, Frais alloués — aucune
                     donnée supprimée du modèle, uniquement repliée par défaut. -->
                <Button HorizontalAlignment="Left" Margin="4,8,0,0" Padding="8,4" Command="{Binding ToggleResultsBreakdownCommand}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Voir les détails ▼" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowResultsBreakdown}" Value="True">
                                        <Setter Property="Text" Value="Masquer les détails ▲" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <UniformGrid Columns="4" Margin="0,8,0,0" Visibility="{Binding ShowResultsBreakdown, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Droits de douane (DD)" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalDroitsDouaneDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="CS" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalCsDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="TVA" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalTvaDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                    </StackPanel>
                    <!-- Correction 2026-10-02 (demande utilisateur — ambiguïté CS/TCS) : la ligne "TCS" du
                         bandeau est RETIRÉE de l'affichage (CS reste la seule taxe de ce type présentée à
                         l'utilisateur, conformément à la décision explicite prise pour cette correction). Le
                         calcul/total interne du TCS (TotalTcsDzd, moteur réglementaire, TOTAL DÉDOUANEMENT)
                         reste intégralement conservé — rien n'est supprimé du modèle ni du moteur, seule cette
                         ligne d'affichage disparaît pour lever l'ambiguïté visuelle CS/TCS signalée. -->
                    <StackPanel Margin="4">
                        <TextBlock Text="PRCT" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalPrctDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="DAPS" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalDapsDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                    </StackPanel>
                    <StackPanel Margin="4" ToolTip="Montant RPS (Redevance de Prestation de Service) déjà inclus dans « Frais alloués » ci-contre — affiché ici séparément à titre indicatif, jamais une seconde fois dans le COÛT DE REVIENT.">
                        <TextBlock Text="RPS" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalRpsDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                    </StackPanel>
                    <!-- Tâche #21, point 2 (audit RPS) : "Frais alloués" est la somme de TOUS les frais
                         inclus dans le coût de revient (fret, RPS, assurance, etc. — tout frais dont la case
                         "Inclure dans le coût de revient" est cochée) — le RPS en fait partie et n'est PAS
                         ajouté une seconde fois en plus de ce total. Le libellé et l'infobulle le précisent
                         explicitement pour éviter toute addition manuelle erronée par l'utilisateur
                         ("RPS" + "Frais alloués" + "Total Dédouanement" ne doivent JAMAIS être additionnés
                         entre eux : seul COÛT DE REVIENT est le total économique réel, voir
                         ImportDetailViewModel.ApplySummaryToUi). -->
                    <StackPanel Margin="4" ToolTip="Somme de TOUS les frais inclus dans le coût de revient (fret, RPS, assurance...) dont la case « Inclure dans le coût de revient » est cochée — le RPS ci-contre EN FAIT PARTIE, il n'est pas ajouté en plus.">
                        <TextBlock Text="Frais alloués (y compris RPS)" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TotalFraisDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Hauteur BORNÉE volontaire (Tâche #20, point 2) : à l'intérieur du StackPanel/ScrollViewer de
             page ci-dessus, un conteneur sans hauteur explicite se dimensionnerait sur tout son contenu
             (hauteur "infinie" disponible), ce qui désactiverait la barre de défilement VERTICALE PROPRE
             des DataGrid (Articles/Frais/Notifications) — exactement le défaut à éviter ("ScrollViewer
             imbriqué qui casse le DataGrid"). En fixant ici une hauteur raisonnable, chaque DataGrid garde
             sa PROPRE barre de défilement verticale (et son défilement horizontal, inchangé, pour la table
             Articles qui compte de nombreuses colonnes) ; le ScrollViewer de PAGE ne sert qu'à faire défiler
             le reste (bandeaux, cartes de résultats, en-têtes d'onglets, section Notifications) lorsque la
             fenêtre est trop petite ou que les détails sont dépliés. -->
        <TabControl Height="480" VerticalAlignment="Top">
            <TabItem Header="Articles">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                        <Button Content="Ajouter un article manuellement" Command="{Binding AddLineCommand}" />
                        <Button Content="Importer depuis Excel / CSV..." Command="{Binding ImportExcelCommand}" />
                    </StackPanel>
                    <!-- Tâche #21, point 3 : la table Articles compte de nombreuses colonnes — la barre de
                         défilement HORIZONTALE propre au DataGrid est explicitement forcée ici
                         (ScrollViewer.HorizontalScrollBarVisibility="Auto") pour rester visible quelle que
                         soit la largeur de fenêtre, indépendamment du ScrollViewer de PAGE (toujours
                         vertical uniquement, HorizontalScrollBarVisibility="Disabled" — voir plus haut).
                         La barre verticale PROPRE au DataGrid (ScrollViewer.VerticalScrollBarVisibility)
                         est également forcée à "Auto" pour conserver son propre défilement de lignes, sans
                         dépendre uniquement de la hauteur bornée du TabControl parent. Toutes les colonnes,
                         y compris celles situées le plus à droite, restent ainsi accessibles par défilement
                         horizontal du tableau lui-même. -->
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Référence" Binding="{Binding ProductReference}" Width="80" />
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Designation}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Section 7/12/13 de la refonte : "Prix achat" fusionne montant + symbole de -->
                            <!-- devise (ex "2,40 €") en lecture, tout en restant éditable en saisie (valeur -->
                            <!-- brute, sans symbole, pendant l'édition) — plus de colonne "Dev." séparée. -->
                            <DataGridTemplateColumn Header="Prix achat" Width="90" SortMemberPath="UnitPurchasePrice">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right">
                                            <Run Text="{Binding UnitPurchasePrice, StringFormat=N2, Mode=OneWay}" />
                                            <Run Text="{Binding CurrencyCode, Converter={StaticResource CurrencyCodeToSymbolConverter}, Mode=OneWay}" FontSize="10" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding UnitPurchasePrice, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Origine" Binding="{Binding OriginCountryIso2}" Width="55" />
                            <DataGridTextColumn Header="Code SH" Binding="{Binding HsCodeConfirmed10}" Width="100" />

                            <!-- Revue du 2026-10-05 ("DD Excel prioritaire par défaut", remplace le Bug 2 du -->
                            <!-- 2026-10-05) : nouvel ordre de colonnes demandé — 1) DD IA (proposition du -->
                            <!-- moteur réglementaire, à titre de comparaison UNIQUEMENT, placée À GAUCHE), -->
                            <!-- 2) indicateur de différence si DD IA ≠ DD Excel, puis plus loin : DD Excel, -->
                            <!-- CS, TVA, PRCT, RPS regroupés ensemble (voir plus bas). Le Droit de Douane -->
                            <!-- Excel reste utilisé PAR DÉFAUT pour le calcul dès qu'il existe, SANS -->
                            <!-- confirmation ; "Forcer DD IA" (case à cocher plus bas) permet de lui -->
                            <!-- substituer explicitement la proposition DD IA pour une ligne donnée. -->
                            <DataGridTextColumn Header="DD IA %" Binding="{Binding AiProposedDutyRatePercent, Converter={StaticResource FlexibleDecimalConverter}}" Width="75" IsReadOnly="True"
                                                 Visibility="{Binding Data.HasAnyExcelDutyRate, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridTextColumn Header="⚠ Différence DD" Binding="{Binding DutyRateDifferenceIndicator}" Width="190" IsReadOnly="True"
                                                 Visibility="{Binding Data.HasAnyExcelDutyRate, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridTextColumn Header="Statut IA" Binding="{Binding AiHsSummary}" Width="140" IsReadOnly="True"
                                                 Visibility="{Binding Data.HasAnyAiProposedHs, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridTemplateColumn Header="SH (IA)" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Proposer" Command="{Binding DataContext.ConfirmHsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="TVA manuelle %" Binding="{Binding ManualVatRatePercent, Converter={StaticResource FlexibleDecimalConverter}}" Width="95"
                                                 Visibility="{Binding Data.HasAnyManualVatRate, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridCheckBoxColumn Header="TVA manuelle confirmée" Binding="{Binding UserConfirmedManualVatRate}" Width="90"
                                                     Visibility="{Binding Data.HasAnyManualVatRate, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridTextColumn Header="Motif exonération TVA" Binding="{Binding VatExemptionReasonFr}" Width="140"
                                                 Visibility="{Binding Data.HasAnyVatExemptionReason, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Section 18 : colonnes financières compactes, chaque montant en DA. -->
                            <DataGridTextColumn Header="Valeur douane" Binding="{Binding ValeurDouaniereDzd, Converter={StaticResource MoneyDaConverter}}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="DD" Binding="{Binding DroitDouaneDzd, Converter={StaticResource MoneyDaConverter}}" Width="85" IsReadOnly="True" />

                            <!-- Revue du 2026-10-05 ("DD Excel prioritaire par défaut") : DD Excel regroupé -->
                            <!-- ici, juste avant CS/TVA/PRCT/RPS, conformément à la nouvelle maquette. -->
                            <!-- Utilisé PAR DÉFAUT pour le calcul dès qu'il existe (ExcelDutyRatePercent), -->
                            <!-- SANS confirmation requise — remplace l'ancienne case "DD Excel confirmé" -->
                            <!-- (Bug 2 du 2026-10-05, retirée). "Forcer DD IA" permet, pour cette ligne -->
                            <!-- précise, d'utiliser la proposition DD IA (colonne "DD IA %" ci-dessus) à la -->
                            <!-- place du DD Excel ; "Statut DD" explique la source réellement appliquée. -->
                            <DataGridTextColumn Header="DD Excel %" Binding="{Binding ExcelDutyRatePercent, Converter={StaticResource FlexibleDecimalConverter}}" Width="80"
                                                 Visibility="{Binding Data.HasAnyExcelDutyRate, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridCheckBoxColumn Header="Forcer DD IA" Binding="{Binding ForceAiDutyRate}" Width="80"
                                                     Visibility="{Binding Data.HasAnyExcelDutyRate, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridTextColumn Header="Statut DD" Binding="{Binding DutyComparisonLabel}" Width="220" IsReadOnly="True"
                                                 Visibility="{Binding Data.HasAnyExcelDutyRate, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <DataGridTextColumn Header="CS" Binding="{Binding CsDzd, Converter={StaticResource MoneyDaConverter}}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="TVA" Binding="{Binding TvaDzd, Converter={StaticResource MoneyDaConverter}}" Width="90" IsReadOnly="True" />
                            <!-- Revue du 2026-10-02 (demande utilisateur, Section 2) : colonne "TCS" volontairement
                                 RETIRÉE de l'affichage du tableau des articles (seule "CS" reste affichée ici) —
                                 le support interne du TCS (calcul réglementaire, ImportLineRowViewModel.TcsDzd,
                                 total TCS du résumé supérieur) reste intégralement conservé, rien n'est supprimé
                                 du modèle ni du moteur de calcul. -->
                            <DataGridTextColumn Header="PRCT" Binding="{Binding PrctDzd, Converter={StaticResource MoneyDaConverter}}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="RPS" Binding="{Binding RpsAllocatedDzd, Converter={StaticResource MoneyDaConverter}}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="PU Reviens" Binding="{Binding PuReviensDzd, Converter={StaticResource MoneyDaConverter}}" Width="100" IsReadOnly="True" />

                            <!-- Section 11/12/13 : en-tête ET visibilité dynamiques — masquées entièrement -->
                            <!-- si la devise d'autorisation == devise principale (aucune conversion utile). -->
                            <DataGridTextColumn Width="100" IsReadOnly="True"
                                                 Visibility="{Binding Data.NeedsAuthorizationDisplay, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding Data.AuthorizationCurrencySymbol, Source={StaticResource Proxy}, StringFormat='PU {0}'}" />
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <MultiBinding Converter="{StaticResource MoneyDynamicConverter}">
                                        <Binding Path="AuthorizationUnitPrice" />
                                        <Binding Path="AuthorizationCurrencyLabel" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="105" IsReadOnly="True"
                                                 Visibility="{Binding Data.NeedsAuthorizationDisplay, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding Data.AuthorizationCurrencySymbol, Source={StaticResource Proxy}, StringFormat='Total {0}'}" />
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <MultiBinding Converter="{StaticResource MoneyDynamicConverter}">
                                        <Binding Path="AuthorizationTotalAmount" />
                                        <Binding Path="AuthorizationCurrencyLabel" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>

                            <!-- Section 15/16/17 : prix de vente (saisi), bénéfice et % bénéfice (calculés). -->
                            <DataGridTextColumn Header="Prix de vente DA" Binding="{Binding SalePriceDzd, Converter={StaticResource FlexibleDecimalConverter}, UpdateSourceTrigger=LostFocus}" Width="100" />
                            <DataGridTextColumn Header="Bénéfice DA" Binding="{Binding ProfitDzd, Converter={StaticResource MoneyDaConverter}}" Width="95" IsReadOnly="True" />
                            <DataGridTextColumn Header="% Bénéfice" Binding="{Binding ProfitPercent, StringFormat={}{0:N2} %, TargetNullValue='—'}" Width="85" IsReadOnly="True" />

                            <DataGridTextColumn Header="État" Binding="{Binding EtatLabel}" Width="95" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Détail" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Voir" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="✕" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Frais (19 catégories)">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                        <ComboBox ItemsSource="{Binding FeeTemplates}" SelectedItem="{Binding SelectedFeeTemplate}"
                                  DisplayMemberPath="DefaultLabelFr" Width="260" />
                        <Button Content="Ajouter ce frais" Command="{Binding AddFeeCommand}" />
                    </StackPanel>
                    <DataGrid x:Name="FeesDataGrid" ItemsSource="{Binding Fees}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding FeeCategoryCode}" Width="140" />
                            <DataGridTextColumn Header="Libellé" Binding="{Binding FeeName}" Width="160" />
                            <!-- Section 7/13 : montant + symbole fusionnés (plus de colonne "Devise" séparée), -->
                            <!-- édition en valeur brute via le mode édition dédié. -->
                            <DataGridTemplateColumn x:Name="FeesMontantColumn" Header="Montant" Width="95" SortMemberPath="Amount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right">
                                            <Run Text="{Binding Amount, StringFormat=N2, Mode=OneWay}" />
                                            <Run Text="{Binding CurrencyCode, Converter={StaticResource CurrencyCodeToSymbolConverter}, Mode=OneWay}" FontSize="10" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <!-- Revue du 2026-10-02 (demande utilisateur, Section 2 — "restaurer le choix de
                                 devise des frais") : colonne "Devise" réintroduite en ComboBox éditable (DA
                                 pré-sélectionné pour les frais locaux, devise de la facture pour les frais à
                                 l'étranger — voir ImportDetailViewModel.AddFeeFromTemplate), modifiable à tout
                                 moment par l'utilisateur. Liste centralisée et extensible : ImportFeeCatalog.SupportedFeeCurrencies. -->
                            <DataGridComboBoxColumn Header="Devise" SelectedItemBinding="{Binding CurrencyCode}" Width="80"
                                                     ItemsSource="{x:Static core:ImportFeeCatalog.SupportedFeeCurrencies}" />
                            <!-- Correction 2026-10-02 (audit de traduction française) : la sélection réelle
                                 (SelectedItemBinding) reste directement liée à la valeur d'énumération C#
                                 (aucun impact sur la logique de calcul), mais l'AFFICHAGE — cellule en lecture
                                 comme items du menu déroulant — passe par FeeAllocationMethodToFrenchConverter
                                 pour ne jamais montrer de texte anglais brut ("ByValue", "FixedAmount"...). -->
                            <!-- Correction 2026-10-02 (PRIORITÉ 0 — crash "Frais") : DataGridComboBoxColumn génère en
                                 mode "affichage" (hors édition) un élément interne nommé TextBlockComboBox, qui
                                 est en réalité une sous-classe de ComboBox (et non de TextBlock, malgré son nom).
                                 Un Style TargetType="TextBlock" provoquait donc systématiquement
                                 InvalidOperationException ("Le TargetType 'TextBlock' ne correspond pas au type
                                 de l'élément 'TextBlockComboBox'") dès l'ouverture de l'onglet "Frais". Corrigé en
                                 ciblant ComboBox (comme pour EditingElementStyle ci-dessous) et en pilotant le
                                 texte affiché via ItemTemplate (jamais via un Setter "Text", non applicable à un
                                 ComboBox non éditable) — l'affichage ET l'édition utilisent ainsi exactement le
                                 même modèle visuel (toujours le libellé français, jamais la valeur anglaise brute
                                 de l'énumération). -->
                            <DataGridComboBoxColumn Header="Méthode de répartition" SelectedItemBinding="{Binding AllocationMethod}" Width="150"
                                                     ItemsSource="{x:Static core:ImportFeeCatalog.AllocationMethodsForV1}">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FeeAllocationMethodToFrenchConverter}}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FeeAllocationMethodToFrenchConverter}}" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridCheckBoxColumn Header="Inclus valeur en douane" Binding="{Binding IncludeInCustomsValue}" Width="130" />
                            <DataGridCheckBoxColumn Header="Inclus coût de revient" Binding="{Binding IncludeInCostOfGoods}" Width="130" />
                            <DataGridTemplateColumn Header="Supprimer" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding DataContext.RemoveFeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Taux de change &amp; Incoterm">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="{Binding MainCurrencyRateSectionHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ExchangeRateInfo}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <CheckBox Content="Utiliser un taux de change manuel (⚠️ déclenchera une alerte si différent du taux officiel)"
                              IsChecked="{Binding IsManualRateMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16" Visibility="{Binding IsManualRateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Content="{Binding MainCurrencyManualRateLabel}" />
                        <TextBox Text="{Binding ManualRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" Width="120" />
                    </StackPanel>

                    <Separator Margin="0,4,0,12" />

                    <TextBlock Text="Autorisation d'importation (conversion commerciale, distincte du calcul douanier)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Label Content="Devise de l'autorisation d'importation :" />
                        <TextBox Text="{Binding AuthorizationCurrencyCode, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </StackPanel>

                    <!-- Correction 2026-10-02 (demande utilisateur) : JAMAIS de champ "1 [devise facture] = X
                         [devise autorisation]" (ex: "1 EUR = X USD") saisi directement. La devise
                         d'autorisation (ex: USD) a SON PROPRE taux réglementaire vers le DZD, saisi/affiché
                         exactement comme celui de la devise facture ci-dessus. Le taux commercial
                         EUR/USD n'est qu'une information CALCULÉE, affichée ci-dessous (AuthorizationExchangeRateInfo),
                         jamais un champ de saisie. -->
                    <TextBlock Text="{Binding AuthorizationCurrencyRateSectionHeader}" FontWeight="Bold" FontSize="13" Margin="0,8,0,4" />
                    <CheckBox Content="Utiliser un taux manuel pour la devise d'autorisation (⚠️ taux réglementaire PAR DEVISE, distinct de tout taux croisé)"
                              IsChecked="{Binding IsManualAuthorizationRateMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8" Visibility="{Binding IsManualAuthorizationRateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Content="{Binding AuthorizationCurrencyManualRateLabel}" />
                        <TextBox Text="{Binding ManualAuthorizationRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" Width="120" />
                    </StackPanel>

                    <TextBlock Text="{Binding AuthorizationExchangeRateInfo}" TextWrapping="Wrap" Margin="0,4,0,4" FontStyle="Italic" />

                    <TextBlock Text="{Binding AuthorizationConversionSummary}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Separator Margin="0,4,0,12" />

                    <!-- PRIORITÉ 3 (demande utilisateur 2026-10-02) — "Simulation du taux de change" :
                         entièrement virtuelle/lecture seule (ImportSimulatorService, clone isolé en mémoire) —
                         ne modifie JAMAIS l'importation réelle, les lignes, les frais ni le prix de vente. -->
                    <TextBlock Text="Simulation de variation du taux de change" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Text="Prévoyez l'impact d'une hausse ou d'une baisse future du taux de change sur cette importation, sans rien modifier de réel. Les points ci-dessous sont des DA ajoutés ou retranchés au taux actuel (jamais un pourcentage)."
                               TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,6" />

                    <StackPanel Visibility="{Binding SimulationAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding SimulationCurrentRateLabelFr}" FontWeight="Bold" />
                        <TextBlock Text="{Binding SimulationSimulatedRateLabelFr}" Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="-5" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="-5" />
                            <Button Content="-4" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="-4" />
                            <Button Content="-3" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="-3" />
                            <Button Content="-2" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="-2" />
                            <Button Content="-1" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="-1" />
                            <Button Content="0" Width="36" FontWeight="Bold" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="0" />
                            <Button Content="+1" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="1" />
                            <Button Content="+2" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="2" />
                            <Button Content="+3" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="3" />
                            <Button Content="+4" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="4" />
                            <Button Content="+5" Width="36" Command="{Binding SetSimulationDeltaCommand}" CommandParameter="5" />
                        </StackPanel>

                        <!-- Tableau du scénario simulé — jamais enregistré, jamais utilisé pour le calcul réel. -->
                        <Border BorderBrush="#C5CAE9" BorderThickness="1" Padding="8" Background="#F5F7FA">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Valeur en douane (simulée)" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SimulationValeurDouaneDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Total dédouanement (simulé)" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SimulationTotalDedouanementDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Coût de revient (simulé)" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SimulationCoutRevientDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Prix de vente (inchangé)" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SimulationTotalPrixVenteDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Bénéfice (simulé)" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SimulationBeneficeDzd, Converter={StaticResource MoneyDaConverter}}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="% Bénéfice (simulé)" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SimulationPourcentageBeneficeDisplayFr}" FontSize="15" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SimulationCurrentRateLabelFr}"
                               Visibility="{Binding SimulationAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                               TextWrapping="Wrap" Foreground="#B00020" Margin="0,0,0,12" />

                    <Separator Margin="0,4,0,12" />

                    <TextBlock Text="Recommandations liées à l'Incoterm" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding IncotermGuidance}" TextWrapping="Wrap" />

                    <Separator Margin="0,12,0,12" />

                    <!-- Tâche #21, point 5 ("Retirer la TCS de l'écran V1") : la TCS n'est plus exposée ici
                         — la Contribution de Solidarité (CS) est désormais LA taxe de solidarité visible
                         côté utilisateur. La confirmation manuelle CS ci-dessous alimente la MÊME taxe CS
                         que "CS (%)" du bloc "Taux de taxes par défaut" plus bas (ImportOperation.
                         UserConfirmedManualCs / ManualCsRatePercent) — jamais un second champ CS
                         concurrent. (L'ancien champ manuel TCS reste techniquement disponible dans le
                         modèle de données pour la compatibilité des imports déjà enregistrés, mais n'est
                         plus saisissable depuis cet écran.) -->
                    <TextBlock Text="PRCT / CS : confirmation manuelle (une seule fois pour tout l'import)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Si aucune règle réglementaire officielle PRCT/CS n'est publiée pour un code SH de cette importation, confirmez ici un taux valable pour TOUTE l'importation (jamais par article) — une règle officielle reste toujours prioritaire si elle existe." />
                    <CheckBox Content="Confirmer un taux PRCT manuel pour cette importation" IsChecked="{Binding IsManualPrctMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12" Visibility="{Binding IsManualPrctMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Content="Taux PRCT manuel (%) :" />
                        <TextBox Text="{Binding ManualPrctRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" Width="80" />
                    </StackPanel>
                    <CheckBox Content="Confirmer un taux CS manuel pour cette importation" IsChecked="{Binding IsManualCsMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsManualCsMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Content="Taux CS manuel (%) :" />
                        <TextBox Text="{Binding ManualCsRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" Width="80" />
                    </StackPanel>

                    <!-- Revue du 2026-10-05 ("DD Excel prioritaire par défaut", remplace le Bug 2 du -->
                    <!-- 2026-10-05) : section PUREMENT INFORMATIVE, visible uniquement si au moins un -->
                    <!-- article possède un Droit de douane Excel. Aucune confirmation n'est requise : le -->
                    <!-- DD Excel est utilisé PAR DÉFAUT pour le calcul dès qu'il existe. Le DD "IA" -->
                    <!-- (proposition du moteur réglementaire à partir du Code SH) reste calculé et affiché à -->
                    <!-- titre de comparaison (colonne "DD IA %" du tableau) ; pour l'utiliser à la place du -->
                    <!-- DD Excel sur une ligne précise, cochez "Forcer DD IA" dans le tableau des articles. -->
                    <StackPanel Visibility="{Binding HasAnyExcelDutyRate, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Separator Margin="0,12,0,12" />
                        <TextBlock Text="Droit de douane (DD) provenant du fichier Excel" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Un ou plusieurs articles de cette importation possèdent un Droit de douane (DD) importé depuis le fichier Excel (colonne « DD Excel % »). Ce taux est utilisé PAR DÉFAUT pour le calcul, sans confirmation. Le DD « IA » proposé automatiquement par le moteur réglementaire (Code SH) reste affiché à titre de comparaison (colonne « DD IA % » et « ⚠ Différence DD » du tableau des articles) ; pour l'utiliser à la place du DD Excel sur un article précis, cochez « Forcer DD IA » sur sa ligne." />
                    </StackPanel>

                    <Separator Margin="0,12,0,12" />

                    <!-- Revue du 2026-10-02 (correction urgente, Section 20) : taux de taxes PAR DÉFAUT -->
                    <!-- de l'importation, utilisés automatiquement pour TOUS les articles lorsqu'aucune -->
                    <!-- RegulatoryRule officielle n'est trouvée — jamais pour écraser une règle officielle. -->
                    <TextBlock Text="Taux de taxes par défaut (utilisés si la règle réglementaire est introuvable)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Appliqués AUTOMATIQUEMENT à TOUS les articles de cette importation dès qu'aucune règle réglementaire officielle n'a été trouvée pour un code SH — une règle officielle reste toujours prioritaire. Le Droit de Douane (DD) reste résolu article par article : seule la valeur de repli ci-dessous est commune." />
                    <CheckBox Content="☑ Utiliser les taux par défaut lorsque la règle réglementaire est introuvable"
                              IsChecked="{Binding UseDefaultRatesWhenRuleMissing}" Margin="0,0,0,8" FontWeight="Bold" />
                    <Grid Visibility="{Binding UseDefaultRatesWhenRuleMissing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <!-- Tâche #21, point 5 : la ligne "TCS (%)" est retirée de ce bloc (TCS plus exposée
                             en V1) — "RPS suggéré (DA)" remonte d'une ligne pour combler l'espace.
                             DD/CS/PRCT/TVA/RPS-suggéré sont conservés à l'identique. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="DD par défaut (%) :" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DefaultDdRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="0" Grid.Column="3" Content="CS (%) :" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding DefaultCsRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="1" Grid.Column="0" Content="PRCT (%) :" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefaultPrctRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="1" Grid.Column="3" Content="RPS suggéré (DA) :" />
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding DefaultRpsAmountValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                        <Label Grid.Row="2" Grid.Column="0" Content="TVA (%) :" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DefaultTvaRateValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Revue du 2026-10-02 (demande utilisateur, Sections 7 & 8) : onglet renommé "Calcul &
                 Contrôles" -> "Notifications" (les boutons Exporter Excel/PDF ont été déplacés dans le menu
                 "Fichier" — voir MainWindow.xaml — réutilisant EXACTEMENT les mêmes commandes, aucune
                 logique dupliquée). Ce volet présente désormais une notification UNIQUE au niveau de
                 l'IMPORTATION (regroupée par type, jamais répétée par article), avec un bouton "Voir les
                 détails" pour afficher/masquer la liste complète par article en dessous. -->
            <TabItem Header="Notifications">
                <DockPanel Margin="4">
                    <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,8" Background="#FFF4CE">
                        <TextBlock Text="{Binding NotificationBannerFr}" FontWeight="Bold" TextWrapping="Wrap" FontSize="14" Foreground="#7A5B00" />
                    </Border>

                    <!-- Section 7 : résumé regroupé PAR TYPE (une seule ligne par anomalie, avec le nombre
                         d'articles concernés) — "Éléments à vérifier". Tâche #21, point 4 : sélectionner une
                         ligne ici filtre désormais le détail ci-dessous (SelectedAnomalyGroup) — le
                         regroupement lui-même (AnomalyGroupingService.GroupByCode) reste inchangé. -->
                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding AnomalyGroups}"
                              SelectedItem="{Binding SelectedAnomalyGroup, Mode=TwoWay}"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              MaxHeight="220" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Width="110" />
                            <DataGridTextColumn Header="Élément à vérifier" Binding="{Binding LabelFr}" Width="*" />
                            <DataGridTextColumn Header="Occurrences" Binding="{Binding OccurrenceCount}" Width="100" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Padding="8,4" Command="{Binding ToggleAnomalyDetailsCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Voir les détails ▼" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowAnomalyDetails}" Value="True">
                                                <Setter Property="Text" Value="Masquer les détails ▲" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <!-- Tâche #21, point 4 : indique clairement le filtre actif et permet de revenir à
                             la liste complète en un clic — n'affecte jamais AnomalyGroups ni Anomalies,
                             uniquement SelectedAnomalyGroup (donc FilteredAnomalies). -->
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontStyle="Italic" Foreground="#555"
                                   Visibility="{Binding SelectedAnomalyGroup, Converter={StaticResource NullToVisibilityConverter}}"
                                   Text="{Binding SelectedAnomalyGroup.LabelFr, StringFormat='Filtré sur : {0}'}" />
                        <Button Padding="8,4" Margin="8,0,0,0" Content="Afficher toutes les anomalies"
                                Command="{Binding ClearAnomalyGroupSelectionCommand}"
                                Visibility="{Binding SelectedAnomalyGroup, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Section 7 : détail PAR ARTICLE — affiché uniquement sur demande explicite de
                         l'utilisateur ("Voir les détails"), jamais par défaut (évite la répétition). Tâche
                         #21, point 4 : la source est désormais FilteredAnomalies (toutes les anomalies si
                         aucune notification n'est sélectionnée ci-dessus, uniquement celles du même
                         AnomalyCode sinon) — Anomalies (liste brute complète) reste intégralement
                         disponible/inchangée dans le ViewModel. -->
                    <DataGrid ItemsSource="{Binding FilteredAnomalies}" IsReadOnly="True" AutoGenerateColumns="False"
                              Visibility="{Binding ShowAnomalyDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Width="110" />
                            <DataGridTextColumn Header="Code" Binding="{Binding AnomalyCode}" Width="160" />
                            <DataGridTextColumn Header="Article n°" Binding="{Binding LineNumber}" Width="70" />
                            <DataGridTextColumn Header="Message" Binding="{Binding MessageFr}" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
