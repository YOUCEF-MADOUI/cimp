<UserControl x:Class="ImportCostAlgeria.Presentation.Views.EntreprisesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Entreprises" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="Nouvelle entreprise" Command="{Binding NewCommand}" />
                <Button Content="Actualiser" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Companies}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100" />
                    <DataGridTextColumn Header="Raison sociale" Binding="{Binding LegalName}" Width="*" />
                    <DataGridTextColumn Header="NIF" Binding="{Binding NIF}" Width="120" />
                    <DataGridTextColumn Header="Devise" Binding="{Binding DefaultFunctionalCurrency}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Padding="16"
                Visibility="{Binding Selected, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel DataContext="{Binding Selected}">
                <TextBlock Text="Fiche entreprise" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                <Label Content="Code" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="Raison sociale" />
                <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="NIF (Numéro d'Identification Fiscale)" />
                <TextBox Text="{Binding NIF, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="NIS (Numéro d'Identification Statistique)" />
                <TextBox Text="{Binding NIS, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="RC (Registre du Commerce)" />
                <TextBox Text="{Binding RC, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="Devise fonctionnelle par défaut" />
                <TextBox Text="{Binding DefaultFunctionalCurrency, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" />

                <CheckBox Content="TVA d'importation non récupérable (incluse au coût de revient)"
                          IsChecked="{Binding IsImportVatNonRecoverable}" Margin="4,16,4,4" />

                <Button Content="Enregistrer" HorizontalAlignment="Left" Margin="4,20,4,4"
                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
