<Window x:Class="ImportCostAlgeria.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CIMP — Coût d'Importation Maître Pro (Algérie)" Height="860" Width="1500"
        WindowStartupLocation="CenterScreen">
    <!--
    Revue du 2026-10-02 (REFONTE INTERFACE — Section 1/2/3) : l'ancien volet de navigation gauche
    (Tableau de bord / Entreprises / Importations / Réglementation / Taux de change / Journal d'audit /
    Paramètres & Utilisateurs) est entièrement SUPPRIMÉ, remplacé par une barre de menu classique en haut
    (Fichier / Édition / Paramètres / Aide). Aucune fonctionnalité n'est perdue : chaque écran reste
    accessible depuis "Paramètres" (ouvert dans une fenêtre dédiée, voir ChildScreenWindow) — SEULE
    l'écran "Importations" reste directement intégré au contenu principal, qui est désormais l'écran de
    démarrage de l'application (Section 3).
    -->
    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="13">
            <MenuItem Header="_Fichier">
                <MenuItem Header="Nouvelle importation" Command="{Binding NewImportCommand}" />
                <Separator />
                <MenuItem Header="Quitter" Command="{Binding QuitCommand}" />
            </MenuItem>
            <MenuItem Header="_Édition">
                <MenuItem Header="Actualiser la liste des importations" Command="{Binding RefreshImportationsCommand}" />
            </MenuItem>
            <MenuItem Header="_Paramètres">
                <MenuItem Header="Entreprises" Command="{Binding OpenEntreprisesCommand}" />
                <MenuItem Header="Utilisateurs, rôles &amp; sécurité" Command="{Binding OpenParametresCommand}" />
                <Separator />
                <MenuItem Header="Taux de change" Command="{Binding OpenTauxDeChangeCommand}" />
                <MenuItem Header="Paramètres fiscaux &amp; réglementation (SH, taxes)" Command="{Binding OpenReglementationCommand}" />
                <Separator />
                <MenuItem Header="Journal d'audit" Command="{Binding OpenAuditCommand}" />
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Header="À propos de CIMP" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#1A237E" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="CIMP" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Entreprise active :" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}"
                              DisplayMemberPath="LegalName" Width="260" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Session.DisplayLabel}" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section 3 : écran de démarrage = IMPORTATIONS (CurrentView par défaut), plus de panneau de -->
        <!-- navigation latéral — tout l'espace restant est consacré au contenu. -->
        <ContentControl Content="{Binding CurrentView}" Margin="0" />
    </DockPanel>
</Window>
