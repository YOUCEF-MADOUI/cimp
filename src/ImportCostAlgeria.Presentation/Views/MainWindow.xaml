<Window x:Class="ImportCostAlgeria.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CIMP — Coût d'Importation Maître Pro (Algérie)" Height="860" Width="1500"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <!-- Section 5.1 (menu "Édition") : Annuler/Rétablir actifs uniquement lorsque l'écran affiché
             (CurrentView) est la fiche détaillée d'une importation — le binding échoue silencieusement
             (commande absente -> désactivée) sur les autres écrans, sans erreur ni plantage. -->
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding CurrentView.UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding CurrentView.RedoCommand}" />
    </Window.InputBindings>
    <!--
    Revue du 2026-10-02 (REFONTE INTERFACE — Section 1/2/3) : l'ancien volet de navigation gauche
    (Tableau de bord / Entreprises / Importations / Réglementation / Taux de change / Journal d'audit /
    Paramètres & Utilisateurs) est entièrement SUPPRIMÉ, remplacé par une barre de menu classique en haut
    (Fichier / Édition / Paramètres / Aide). Aucune fonctionnalité n'est perdue : chaque écran reste
    accessible depuis "Paramètres" (ouvert dans une fenêtre dédiée, voir ChildScreenWindow) — SEULE
    l'écran "Importations" reste directement intégré au contenu principal, qui est désormais l'écran de
    démarrage de l'application (Section 3).
    -->
    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="13">
            <!-- Revue du 2026-10-02 (demande utilisateur, Sections 9 & 18) : Export Excel/PDF déplacés ici
                 depuis l'ancien onglet "Calcul & Contrôles" (désormais "Notifications") — REUTILISE
                 exactement les mêmes commandes (CurrentView.ExportExcelCommand/ExportPdfCommand, portées
                 par ImportDetailViewModel), aucune logique dupliquée. Ces commandes ne sont actives que
                 lorsque l'écran affiché est la fiche détaillée d'une importation (sinon absentes -> grisées,
                 comportement identique au menu Édition). "Enregistrer sous" et "Imprimer" ne sont PAS
                 ajoutés : aucun service correspondant n'existe aujourd'hui dans CIMP et la consigne
                 "réutiliser les services existants, ne jamais dupliquer la logique" interdit d'en inventer
                 un artificiellement pour remplir le menu (voir rapport final). -->
            <MenuItem Header="_Fichier">
                <MenuItem Header="Nouvelle importation" Command="{Binding NewImportCommand}" />
                <MenuItem Header="Ouvrir l'importation sélectionnée" Command="{Binding CurrentView.OpenCommand}" />
                <MenuItem Header="Enregistrer" Command="{Binding CurrentView.SaveCommand}" />
                <Separator />
                <MenuItem Header="Importer Excel / CSV..." Command="{Binding CurrentView.ImportExcelCommand}" />
                <Separator />
                <MenuItem Header="Exporter en Excel..." Command="{Binding CurrentView.ExportExcelCommand}" />
                <MenuItem Header="Exporter en PDF..." Command="{Binding CurrentView.ExportPdfCommand}" />
                <Separator />
                <!-- Demande utilisateur (Section 7 — connexion automatique) : point d'entrée explicite
                     pour "Utiliser un autre compte" alors que CIMP se connecte normalement tout seul. -->
                <MenuItem Header="Changer de compte..." Command="{Binding SwitchAccountCommand}" />
                <Separator />
                <MenuItem Header="Quitter" Command="{Binding QuitCommand}" />
            </MenuItem>
            <MenuItem Header="_Édition">
                <!-- Section 5.1 : historique Annuler/Rétablir RÉEL (ImportCostAlgeria.Core.Services.UndoRedoManager),
                     porté par la fiche détaillée d'importation (prix, quantité, prix de vente, pays, frais,
                     méthode de répartition, inclusion valeur en douane/coût de revient, taux manuel). -->
                <MenuItem Header="Annuler" Command="{Binding CurrentView.UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="Rétablir" Command="{Binding CurrentView.RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <!-- Section 5 : commandes d'édition standard réutilisant les commandes WPF natives
                     (ApplicationCommands) déjà prises en charge par les contrôles texte/grilles — aucune
                     logique dupliquée. -->
                <MenuItem Header="Couper" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" />
                <MenuItem Header="Copier" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                <MenuItem Header="Coller" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" />
                <MenuItem Header="Supprimer" Command="ApplicationCommands.Delete" InputGestureText="Suppr" />
                <MenuItem Header="Sélectionner tout" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
                <Separator />
                <MenuItem Header="Actualiser la liste des importations" Command="{Binding RefreshImportationsCommand}" />
            </MenuItem>
            <MenuItem Header="_Paramètres">
                <MenuItem Header="Entreprises" Command="{Binding OpenEntreprisesCommand}" />
                <MenuItem Header="Utilisateurs, rôles &amp; sécurité" Command="{Binding OpenParametresCommand}" />
                <Separator />
                <MenuItem Header="Taux de change" Command="{Binding OpenTauxDeChangeCommand}" />
                <MenuItem Header="Paramètres fiscaux &amp; réglementation (SH, taxes)" Command="{Binding OpenReglementationCommand}" />
                <Separator />
                <MenuItem Header="Journal d'audit" Command="{Binding OpenAuditCommand}" />
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Header="À propos de CIMP" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#1A237E" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="CIMP" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Entreprise active :" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}"
                              DisplayMemberPath="LegalName" Width="260" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Session.DisplayLabel}" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section 3 : écran de démarrage = IMPORTATIONS (CurrentView par défaut), plus de panneau de -->
        <!-- navigation latéral — tout l'espace restant est consacré au contenu. -->
        <ContentControl Content="{Binding CurrentView}" Margin="0" />
    </DockPanel>
</Window>
