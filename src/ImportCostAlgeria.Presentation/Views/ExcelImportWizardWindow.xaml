<Window x:Class="ImportCostAlgeria.Presentation.Views.ExcelImportWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Excel / CSV — Assistant de mapping" Height="680" Width="980"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="1. Choisir un fichier..." Command="{Binding BrowseCommand}" />
            <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Margin="12,0,0,0" FontStyle="Italic" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="2. Analyser les colonnes" Command="{Binding AnalyzeCommand}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="700" />
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="3. Correspondance des colonnes">
                <DataGrid ItemsSource="{Binding MappingRows}" AutoGenerateColumns="False" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Colonne" Binding="{Binding ColumnLetter}" Width="70" IsReadOnly="True" />
                        <DataGridTextColumn Header="En-tête du fichier" Binding="{Binding RawHeaderText}" Width="220" IsReadOnly="True" />
                        <DataGridTextColumn Header="Reconnue automatiquement ?" Binding="{Binding WasAutomaticallyRecognized}" Width="150" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Correspond au champ CIMP" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.AllFields, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding MatchedField, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource CanonicalExcelFieldToLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="4. Prévisualisation">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding PreviewLines}" IsReadOnly="True" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Référence" Binding="{Binding ProductReference}" Width="120" />
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="220" />
                            <DataGridTextColumn Header="Quantité" Binding="{Binding Quantity}" Width="80" />
                            <DataGridTextColumn Header="Prix unitaire" Binding="{Binding UnitPurchasePrice}" Width="90" />
                            <DataGridTextColumn Header="Devise" Binding="{Binding CurrencyCode}" Width="60" />
                            <DataGridTextColumn Header="Origine" Binding="{Binding OriginCountryIso2}" Width="60" />
                            <DataGridTextColumn Header="Code SH (Excel)" Binding="{Binding HsCodeConfirmed10}" Width="100" />
                            <DataGridTextColumn Header="Droit Excel %" Binding="{Binding ExcelDutyRatePercent}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding CatalogMessages}" Margin="4" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox Content="Enregistrer ce mapping pour ce fournisseur (réutilisable automatiquement au prochain import)"
                      IsChecked="{Binding SaveAsTemplate}" VerticalAlignment="Center" />
            <TextBox Text="{Binding TemplateName}" Width="200" Margin="8,0,0,0" IsEnabled="{Binding SaveAsTemplate}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="3bis. Valider le mapping et prévisualiser" Command="{Binding ConfirmCommand}" />
            <Button Content="Importer les lignes" Click="OnImportClick" IsEnabled="{Binding ReadyToImport}" />
            <Button Content="Annuler" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
