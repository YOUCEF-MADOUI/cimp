<Window x:Class="ImportCostAlgeria.Presentation.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CIMP — Changement de mot de passe" Height="340" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Changement de mot de passe" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Pour des raisons de sécurité (Section 18), le mot de passe administrateur initial généré automatiquement doit être remplacé avant de continuer."
                   TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,0,0,16" />

        <Label Grid.Row="2" Content="Nouveau mot de passe (8 caractères minimum)" />
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="2" Margin="0,36,0,0" Padding="4,3" />

        <Label Grid.Row="3" Content="Confirmer le nouveau mot de passe" Margin="4,10,4,0" />
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="3" Margin="0,46,0,0" Padding="4,3" />

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="4,8,4,0" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Valider" IsDefault="True" Click="OnValidateClick" />
            <Button x:Name="CancelButton" Content="Annuler" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
