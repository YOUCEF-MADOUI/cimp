<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Application Windows native WPF (Priorité 1 du plan de finalisation).
      Correction NETSDK1137 : le SDK racine est Microsoft.NET.Sdk (et non plus
      Microsoft.NET.Sdk.WindowsDesktop, devenu inutile depuis .NET 6+) — UseWPF=true ci-dessous suffit à
      activer la prise en charge WPF (compilation XAML->BAML, références WindowsBase/PresentationCore/...).
      IMPORTANT (transparence totale — voir rapport final section E) : cette compilation XAML->BAML n'est
      possible QUE sous Windows. Ce projet est donc écrit pour être ouvert, compilé et exécuté par
      l'utilisateur dans Visual Studio 2022 sous Windows (F5), où le SDK .NET 8 complet est disponible.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ImportCostAlgeria.Presentation</RootNamespace>
    <AssemblyName>CIMP</AssemblyName>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>

    <!--
      Préparation V1 publiable (voir packaging/README.txt et scripts/publish-release.ps1) : métadonnées de
      version/produit affichées par Windows (Explorateur, propriétés du .exe) et par l'écran "À propos" de
      l'application. Volontairement SANS aucune information de développement (pas de chemin local, pas de
      nom d'utilisateur Windows, pas de nom/branche Git, pas d'environnement Arena) — uniquement le nom
      commercial du produit et son numéro de version.
    -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>CIMP — Coût d'Importation Algérie</Product>
    <AssemblyTitle>CIMP</AssemblyTitle>
    <Description>CIMP — Coût d'Importation Algérie : calcul du coût de revient réel des marchandises importées (droits de douane, taxes, valeur en douane, frais d'approche).</Description>
    <Company>CIMP</Company>
    <Copyright>© CIMP</Copyright>
    <NeutralLanguage>fr</NeutralLanguage>

    <!--
      Étape 4 (publication Windows 64 bits autonome) : ces propriétés ne forcent PAS le runtime identifier
      lors d'une compilation normale "dotnet build" (sans -r, l'application reste "framework-dependent" et se
      construit exactement comme avant pour le développement courant sous Visual Studio). Elles ne prennent
      effet que lors d'un "dotnet publish -r win-x64 /self-contained true" explicite (voir
      Properties/PublishProfiles/FolderProfile.pubxml et scripts/publish-release.ps1), qui est le seul
      scénario où un utilisateur final doit pouvoir lancer CIMP.exe SANS installer .NET 8.
    -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- Section 4.2 (demande utilisateur — "Se souvenir de moi") : Windows DPAPI pour chiffrer le secret
         mémorisé au repos (RememberedLoginStore / DpapiSecretProtector). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ImportCostAlgeria.Core\ImportCostAlgeria.Core.csproj" />
    <ProjectReference Include="..\ImportCostAlgeria.RegulatoryEngine\ImportCostAlgeria.RegulatoryEngine.csproj" />
    <ProjectReference Include="..\ImportCostAlgeria.CalculationEngine\ImportCostAlgeria.CalculationEngine.csproj" />
    <ProjectReference Include="..\ImportCostAlgeria.ExcelEngine\ImportCostAlgeria.ExcelEngine.csproj" />
    <ProjectReference Include="..\ImportCostAlgeria.Reporting\ImportCostAlgeria.Reporting.csproj" />
    <ProjectReference Include="..\ImportCostAlgeria.Audit\ImportCostAlgeria.Audit.csproj" />
    <ProjectReference Include="..\ImportCostAlgeria.AI\ImportCostAlgeria.AI.csproj" />
    <ProjectReference Include="..\ImportCostAlgeria.Database\ImportCostAlgeria.Database.csproj" />
  </ItemGroup>
</Project>
