<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil de publication "V1 publiable sans abonnement" (voir packaging/README.txt et
  scripts/publish-release.ps1). Utilisable directement depuis Visual Studio
  (clic droit sur ImportCostAlgeria.Presentation → Publier → Dossier → ce profil) ou en ligne de
  commande :

    dotnet publish src/ImportCostAlgeria.Presentation/ImportCostAlgeria.Presentation.csproj ^
      -c Release -p:PublishProfile=FolderProfile

  IMPORTANT : cette publication (self-contained win-x64, compilation XAML→BAML) ne peut s'exécuter que
  sous Windows avec le SDK .NET 8 complet installé — jamais depuis ce sandbox Linux (voir section
  "Limitations" du rapport). Aucune valeur ci-dessous n'active de système de licence, d'abonnement ou
  d'activation : cette V1 reste strictement un exécutable autonome, sans blocage au démarrage.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Les .pdb ne sont pas nécessaires à un utilisateur final (ils ne servent qu'au débogage avec le
         code source) ; ils sont retirés du dossier final par scripts/publish-release.ps1, pas ici, afin
         de garder la possibilité de les régénérer facilement pour du support technique si besoin. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
